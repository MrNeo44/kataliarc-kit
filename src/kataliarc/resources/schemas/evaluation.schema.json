{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KatalIArc Walton qualitative scenario evaluation",
  "type": "object",
  "required": ["rubric_version", "assessments", "comparison", "risks", "sensitivity_points", "tradeoffs", "iteration", "iteration_requests", "iteration_history"],
  "properties": {
    "rubric_version": {"type": "string", "minLength": 1},
    "assessments": {"type": "array", "items": {"$ref": "#/$defs/assessment"}},
    "comparison": {"type": "object", "properties": {"constraints": {"type": "array"}, "dominance": {"type": "array"}, "tradeoffs": {"type": "array"}, "recommendation": {}}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "sensitivity_points": {"type": "array", "items": {"$ref": "#/$defs/sensitivity"}},
    "tradeoffs": {"type": "array", "items": {"$ref": "#/$defs/tradeoff"}},
    "iteration": {"type": "integer", "minimum": 0},
    "iteration_requests": {"type": "array", "items": {"type": "object", "required": ["request_type", "reason", "target_scenario_ids", "target_alternative_ids", "request_for_toulmin"], "properties": {"request_type": {"enum": ["new_tactic", "new_combination", "evidence", "argument_revision", "reevaluation"]}, "reason": {"type": "string"}, "target_scenario_ids": {"type": "array", "items": {"type": "string"}}, "target_alternative_ids": {"type": "array", "items": {"type": "string"}}, "request_for_toulmin": {"type": "string"}, "status": {"enum": ["PENDING", "RESOLVED", "UNRESOLVED"]}}}},
    "iteration_history": {"type": "array", "items": {"type": "object", "required": ["iteration", "action", "observation", "source_artifacts", "outcome"], "properties": {"iteration": {"type": "integer", "minimum": 0}, "action": {"type": "string"}, "observation": {"type": "string"}, "source_artifacts": {"type": "array", "items": {"type": "string"}}, "outcome": {"type": "string"}, "previous_assessments": {"type": "array"}}}},
    "assessment_history": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "required": ["alternative_id", "scenario_id", "tactic_ids", "design_decision", "direction", "rationale", "contribution_direction", "sufficiency", "contribution_label", "neutral_justified", "evidence_status", "compliance_status", "causal_justification", "assumptions", "objections", "critical_question_assessments", "rubric_version"],
      "properties": {
        "alternative_id": {"type": "string"}, "scenario_id": {"type": "string"}, "tactic_ids": {"type": "array", "items": {"type": "string"}}, "design_decision": {"type": "string"},
        "direction": {"enum": ["favorable", "condicionado", "desfavorable", "indeterminado"]}, "rationale": {"type": "string"},
        "contribution_direction": {"enum": ["POSITIVE", "NEGATIVE", "NEUTRAL", "UNKNOWN"]}, "sufficiency": {"enum": ["SUFFICIENT", "INSUFFICIENT", "UNKNOWN"]}, "contribution_label": {"enum": ["MAKE (++)", "HELP (+)", "SomePositive", "HURT (-)", "BREAK (--)", "SomeNegative", "UNKNOWN (?)", "NEUTRAL (0)"]}, "neutral_justified": {"type": "boolean"},
        "evidence_status": {"enum": ["documentada", "inferencia/hipótesis", "desconocida"]}, "compliance_status": {"enum": ["VERIFIED_SATISFIED", "VERIFIED_UNSATISFIED", "PREDICTED_UNDER_ASSUMPTIONS", "UNVERIFIED", "verificado", "provisional", "incumplido", "desconocido"]},
        "causal_justification": {"$ref": "#/$defs/causal"}, "assumptions": {"type": "array", "items": {"type": "string"}}, "objections": {"type": "array"}, "critical_question_assessments": {"type": "array", "items": {"$ref": "#/$defs/critical_question"}}, "rubric_version": {"type": "string"}
      }
    },
    "causal": {"type": "object", "required": ["claim", "mechanism", "evidence", "assumptions", "applicability_conditions", "expected_effect", "sufficiency_rationale", "counterarguments", "conclusion"], "properties": {"claim": {"type": "string"}, "mechanism": {"type": "string"}, "evidence": {"type": "array"}, "assumptions": {"type": "array"}, "applicability_conditions": {"type": "array"}, "expected_effect": {"type": "string"}, "sufficiency_rationale": {"type": "string"}, "counterarguments": {"type": "array"}, "conclusion": {"type": "string"}}},
    "critical_question": {"type": "object", "required": ["scheme", "question", "claim_ref", "answer", "result", "evidence_refs", "objection"], "properties": {"scheme": {"enum": ["practical_reasoning", "causal_argument", "analogy", "expert_opinion", "consequences"]}, "question": {"type": "string"}, "claim_ref": {"type": "string"}, "answer": {"type": "string"}, "result": {"enum": ["supported", "challenged", "unresolved"]}, "evidence_refs": {"type": "array"}, "objection": {"type": ["string", "null"]}}},
    "risk": {"type": "object", "required": ["id", "decision_id", "scenario_ids", "causal_mechanism", "consequence", "evidence", "status", "mitigation"], "properties": {"id": {"type": "string"}, "decision_id": {"type": "string"}, "scenario_ids": {"type": "array", "items": {"type": "string"}}, "causal_mechanism": {"type": "string"}, "consequence": {"type": "string"}, "evidence": {"type": "array"}, "status": {"enum": ["CONFIRMED_CONDITION", "HYPOTHETICAL", "CANDIDATE"]}, "mitigation": {"type": "string"}}},
    "sensitivity": {"type": "object", "required": ["id", "property", "scenario_id", "response_measure", "causal_mechanism", "variation_effect", "status", "evidence"], "properties": {"id": {"type": "string"}, "property": {"type": "string"}, "scenario_id": {"type": "string"}, "response_measure": {}, "causal_mechanism": {"type": "string"}, "variation_effect": {"type": "string"}, "status": {"enum": ["SUPPORTED", "CANDIDATE"]}, "evidence": {"type": "array"}}},
    "tradeoff": {"type": "object", "required": ["id", "decision_id", "property", "affected_scenario_ids", "positive_effects", "negative_effects", "shared_mechanism", "business_priorities", "assumptions", "evidence", "mitigations"], "properties": {"id": {"type": "string"}, "decision_id": {"type": "string"}, "property": {"type": "string"}, "affected_scenario_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "positive_effects": {"type": "array"}, "negative_effects": {"type": "array"}, "shared_mechanism": {"type": "string"}, "business_priorities": {"type": "array"}, "assumptions": {"type": "array"}, "evidence": {"type": "array"}, "mitigations": {"type": "array"}}}
  }
}

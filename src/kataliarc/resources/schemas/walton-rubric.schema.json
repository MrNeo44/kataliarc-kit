{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KatalIArc Walton unified evaluation rubric",
  "type": "object",
  "properties": {
    "id": {"const": "kataliarc-walton-unified-v2"},
    "version": {"const": "2.0.0"},
    "scope": {"const": "alternative-quality-scenario-pair"},
    "criteria": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "id": {"enum": ["C1", "C2", "C3", "C4", "C5", "C6"]},
          "name": {"type": "string", "pattern": "\\S"},
          "question": {"type": "string", "pattern": "\\S"}
        },
        "required": ["id", "name", "question"],
        "additionalProperties": false
      }
    },
    "values": {
      "type": "object",
      "properties": {
        "NO_CUMPLE": {"type": "string", "pattern": "\\S"},
        "INCIERTO": {"type": "string", "pattern": "\\S"},
        "REQUIERE_AJUSTE": {"type": "string", "pattern": "\\S"},
        "CUMPLE": {"type": "string", "pattern": "\\S"}
      },
      "required": ["NO_CUMPLE", "INCIERTO", "REQUIERE_AJUSTE", "CUMPLE"],
      "additionalProperties": false
    },
    "decision_rules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "value": {"enum": ["NO_CUMPLE", "INCIERTO", "REQUIERE_AJUSTE", "CUMPLE"]},
          "action": {"enum": ["DESCARTAR", "POSPONER", "MODIFICAR", "MANTENER"]},
          "rule": {"enum": ["R1", "R2", "R3", "R4"]}
        },
        "required": ["value", "action", "rule"],
        "additionalProperties": false
      }
    },
    "critical_question_schemes": {
      "type": "object",
      "properties": {
        "practical_reasoning": {
          "type": "array",
          "items": {"type": "string", "pattern": "\\S"},
          "minItems": 1
        },
        "causal_argument": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "minItems": 1},
        "analogy": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "minItems": 1},
        "expert_opinion": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "minItems": 1},
        "consequences": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "minItems": 1}
      },
      "required": ["practical_reasoning", "causal_argument", "analogy", "expert_opinion", "consequences"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "scope",
    "criteria",
    "values",
    "decision_rules",
    "critical_question_schemes"
  ],
  "additionalProperties": false
}

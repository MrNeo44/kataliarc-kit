{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KatalIArc versioned Architecture Decision Record",
  "type": "object",
  "required": [
    "adr_id",
    "project_id",
    "origin",
    "status",
    "current_version",
    "versions",
    "history",
    "approval_history",
    "indexing"
  ],
  "properties": {
    "adr_id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "const": "kataliarc"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "UNDER_REVIEW",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_version": {
      "$ref": "#/$defs/version"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "at",
          "actor"
        ]
      }
    },
    "approval_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "actor",
          "version",
          "at"
        ]
      }
    },
    "indexing": {
      "type": "object",
      "required": [
        "status",
        "attempts",
        "history",
        "remote_resources"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_REQUESTED",
            "PENDING",
            "INDEXING",
            "INDEXED",
            "FAILED"
          ]
        },
        "attempts": {
          "type": "array"
        },
        "history": {
          "type": "array"
        },
        "remote_resources": {
          "type": "array"
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "required": [
        "version",
        "created_at",
        "title",
        "sections",
        "source_artifacts"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "object",
          "required": [
            "architectural_problem",
            "business_context_and_objectives",
            "quality_scenarios",
            "constraints",
            "selected_tactics",
            "alternatives_considered",
            "recommended_decision",
            "toulmin_arguments",
            "qualitative_scenario_assessments",
            "evaluation_method",
            "risks_and_sensitivities",
            "tradeoffs",
            "walton_critical_questions",
            "objections_and_counterarguments",
            "evidence_and_references",
            "assumptions_and_uncertainties",
            "expected_consequences",
            "pending_verification",
            "evaluation_iterations",
            "unresolved_evaluation_requests"
          ],
          "properties": {
            "evaluation_iterations": {
              "type": "array"
            },
            "unresolved_evaluation_requests": {
              "type": "array"
            },
            "alternative_results": {
              "type": "array"
            }
          }
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

classDiagram
  class Stakeholder {
    +string id
    +string name
    +string role
  }
  class BusinessProblem {
    +string id
    +string description
    +string provenance
  }
  class BusinessGoal {
    +string id
    +string description
    +string success_measure
  }
  class BusinessRequirement {
    +string id
    +string description
    +priority priority
    +string provenance
  }
  class ArchitecturalProblem {
    +string id
    +string description
    +string[] missing_information
    +string[] assumptions
  }
  class ArchitecturalContext {
    +string system_domain
    +string team_capabilities
    +string technology_environment
  }
  class ArchitecturalConstraint {
    +string id
    +string description
    +boolean mandatory
    +string provenance
    +evidence_status evidence_status
  }
  class QualityAttribute {
    +string name
    +string definition
  }
  class QualityScenario {
    +string id
    +string stimulus
    +string environment
    +string response
    +string response_measure
    +priority importance
    +priority difficulty
    +string acceptance_criteria
    +string[] known_context
    +string[] missing_information
    +boolean mandatory
    +string provenance
    +evidence_status evidence_status
  }
  class ArchitecturalDriver {
    +string id
    +string description
    +priority priority
    +string provenance
  }
  class ArchitecturalKnowledge {
    +string id
    +string description
    +string source_ref
    +evidence_status evidence_status
  }
  class ExplicitArchitecturalKnowledge {
    +string kind
  }
  class TacitArchitecturalKnowledge {
    +string kind
    +string provenance
  }
  class ArchitecturalStyle {
    +string id
    +string name
    +string description
  }
  class ReferenceArchitecture {
    +string id
    +string name
    +string description
    +string source_ref
  }
  class ArchitecturalTactic {
    +string id
    +string name
    +string mechanism
    +string[] target_attributes
    +string[] conditions
    +string[] source_refs
  }
  class ArchitecturalPattern {
    +string id
    +string name
    +string structure
    +string[] components
    +string[] connectors
    +string[] source_refs
  }
  class ExpertHeuristic {
    +string id
    +string condition
    +string recommendation
    +string provenance
    +evidence_status evidence_status
  }
  class ProjectExperience {
    +string id
    +string project_context
    +string observed_outcome
    +string source_ref
    +evidence_status evidence_status
  }
  class PatternTacticInteraction {
    +string fit_label
    +string change_type
    +string[] required_changes
    +string[] preconditions
    +string[] source_refs
    +string[] hypotheses
  }
  class TacticInteraction {
    +string kind
    +string mechanism
    +string[] positive_effects
    +string[] negative_effects
    +string[] conditions
    +string[] mitigations
    +string status
    +string[] source_refs
  }
  class ArchitecturalAlternative {
    +string id
    +string description
    +string[] assembly_relations
    +string[] assumptions
  }
  class ArchitecturalRisk {
    +string id
    +string description
    +string severity
    +string provenance
    +evidence_status evidence_status
  }
  class TradeOff {
    +string id
    +string description
    +string[] affected_scenario_ids
  }
  class ScenarioAssessment {
    +string alternative_id
    +string scenario_id
    +assessment_direction direction
    +string rationale
    +evidence_status evidence_status
    +compliance_status compliance_status
  }
  class DecisionRationale {
    +string justification
    +string[] uncertainties
    +string[] source_refs
  }
  class ArchitecturalDecision {
    +string id
    +decision_status status
    +date decision_date
    +string selected_alternative_id
    +string[] tradeoffs
    +string[] risks
    +string[] unresolved_questions
  }
  class ArchitectureDecisionRecord {
    +string adr_id
    +string project_id
    +string origin
    +string title
    +adr_status status
    +ADRVersion current_version
    +ADRVersion[] versions
    +object[] history
    +object[] approval_history
    +object indexing
    +string supersedes
  }
  class ADRVersion {
    +integer version
    +string created_at
    +string title
    +ADRContent sections
    +string[] source_artifacts
  }
  class ADRContent {
    +string architectural_problem
    +object business_context_and_objectives
    +QualityScenario[] quality_scenarios
    +ArchitecturalConstraint[] constraints
    +ArchitecturalTactic[] selected_tactics
    +object alternatives_considered
    +object recommended_decision
    +ArchitecturalArgument[] toulmin_arguments
    +ScenarioAssessment[] qualitative_scenario_assessments
    +object evaluation_method
    +ArchitecturalRisk[] risks_and_sensitivities
    +TradeOff[] tradeoffs
    +object[] walton_critical_questions
    +object[] objections_and_counterarguments
    +object evidence_and_references
    +string[] assumptions_and_uncertainties
    +string[] expected_consequences
    +string[] pending_verification
  }
  class ArchitecturalArgument {
    +string claim
    +string[] grounds
    +string warrant
    +string[] backing
    +string qualifier
    +string[] rebuttal
    +string[] source_refs
    +evidence_status evidence_status
  }
  class UtilityTreeBranch {
    +string quality_attribute
    +string[] scenario_ids
  }

  note for ScenarioAssessment "Called AlternativeAssessment in the source diagram; runtime artifacts use ScenarioAssessment."

  Stakeholder "1..*" -- "0..*" BusinessProblem : provides context/is affected by
  BusinessProblem --> BusinessGoal : motivates
  BusinessGoal --> BusinessRequirement : informs
  BusinessRequirement --> ArchitecturalProblem : contributes to
  ArchitecturalProblem --> ArchitecturalContext : understood in
  ArchitecturalProblem --> ArchitecturalConstraint : limited by
  ArchitecturalProblem --> ArchitecturalDriver : influenced by
  ArchitecturalDriver --> QualityScenario : includes
  QualityScenario --> QualityAttribute : characterizes
  UtilityTreeBranch --> QualityScenario : indexes scenario IDs
  ArchitecturalKnowledge --> ArchitecturalProblem : may inform
  ArchitecturalKnowledge <|-- ExplicitArchitecturalKnowledge
  ArchitecturalKnowledge <|-- TacitArchitecturalKnowledge
  ExplicitArchitecturalKnowledge --> ArchitecturalStyle : includes
  ExplicitArchitecturalKnowledge --> ReferenceArchitecture : includes
  ExplicitArchitecturalKnowledge --> ArchitecturalTactic : includes
  ExplicitArchitecturalKnowledge --> ArchitecturalPattern : includes
  TacitArchitecturalKnowledge <|-- ExpertHeuristic
  TacitArchitecturalKnowledge <|-- ProjectExperience
  ArchitecturalStyle --> ArchitecturalPattern : may be realized by
  ReferenceArchitecture --> ArchitecturalPattern : may contain or inspire
  ArchitecturalPattern --> PatternTacticInteraction : participates in
  ArchitecturalTactic --> PatternTacticInteraction : participates in
  PatternTacticInteraction --> TacticInteraction : contributes to
  ArchitecturalTactic --> TacticInteraction : interacts with
  TacticInteraction --> QualityScenario : affects
  ArchitecturalTactic --> QualityScenario : targets or affects
  ArchitecturalAlternative --> ArchitecturalPattern : assembles
  ArchitecturalAlternative --> ArchitecturalTactic : uses
  ArchitecturalAlternative --> ScenarioAssessment : assessed by
  ScenarioAssessment --> QualityScenario : assesses against
  ArchitecturalAlternative --> ArchitecturalRisk : may have
  ArchitecturalAlternative --> TradeOff : has trade-off
  ArchitecturalDecision --> ArchitecturalAlternative : selects or defers
  ArchitecturalDecision --> DecisionRationale : justified by
  ArchitecturalDecision --> TradeOff : records
  ArchitectureDecisionRecord --> ArchitecturalDecision : records
  ArchitectureDecisionRecord --> ADRVersion : has versions
  ADRVersion --> ADRContent : contains
  ADRContent --> QualityScenario : traces
  ADRContent --> ArchitecturalTactic : records selected tactics
  ADRContent --> ArchitecturalArgument : preserves arguments
  ADRContent --> ScenarioAssessment : preserves assessments
  ADRContent --> ArchitecturalRisk : records risks
  ADRContent --> TradeOff : records trade-offs
  ArchitecturalArgument --> ArchitecturalAlternative : supports or qualifies

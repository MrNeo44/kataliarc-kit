{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KatalIArc utility tree references",
  "type": "object",
  "required": ["quality_attributes"],
  "properties": {
    "quality_attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "scenario_ids"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "scenario_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

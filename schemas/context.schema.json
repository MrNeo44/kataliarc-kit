{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KatalIArc context",
  "type": "object",
  "required": [
    "business_goals",
    "business_requirements",
    "constraints",
    "quality_attributes",
    "quality_scenarios",
    "references"
  ],
  "properties": {
    "business_goals": {
      "type": "array"
    },
    "business_requirements": {
      "type": "array"
    },
    "constraints": {
      "type": "array"
    },
    "quality_attributes": {
      "type": "array"
    },
    "quality_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "quality_attribute",
          "priority",
          "mandatory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "quality_attribute": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "A",
              "M",
              "B",
              "pendiente"
            ]
          },
          "acceptance_criteria": {
            "type": [
              "string",
              "null"
            ]
          },
          "known_context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_information": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mandatory": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "stimulus": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "response": {
            "type": "string"
          },
          "response_measure": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "metric"
                ],
                "properties": {
                  "metric": {
                    "type": "string"
                  },
                  "operator": {
                    "type": "string"
                  },
                  "value": {},
                  "unit": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "business_relevance": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array"
    }
  }
}
